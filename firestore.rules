rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    match /studyMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mockTests/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testAttempts/{attemptId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
      
      match /answers/{answerId} {
        allow read, write: if isSignedIn() && get(/databases/$(database)/documents/testAttempts/$(attemptId)).data.userId == request.auth.uid;
      }
    }
    match /entitlements/{entitlementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid) || (existing().isAnonymous == false); 
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); 
      allow read, write: if isAdmin();
    }
  }
}
